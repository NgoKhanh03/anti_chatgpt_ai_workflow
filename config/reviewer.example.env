# Browser reviewer — no OpenAI API key required
REVIEWER_TRANSPORT=browser
# CHATGPT_CDP_URL=ws://127.0.0.1:9222/devtools/browser/...
# Default: auto-read ~/Library/Application Support/Google/Chrome/DevToolsActivePort
CHATGPT_URL=https://chatgpt.com/
CHATGPT_TIMEOUT_MS=180000
CHATGPT_SETTLE_MS=2500
CHATGPT_NEW_CHAT_PER_REVIEW=true

# Optional API mode if an API key is available later
# REVIEWER_TRANSPORT=openai
# OPENAI_API_KEY=replace-me
# OPENAI_REVIEW_MODEL=gpt-5
# OPENAI_BASE_URL=https://api.openai.com/v1

# Persistent local CDP agent
CHATGPT_AGENT_URL=http://127.0.0.1:4317
CHATGPT_AGENT_HOST=127.0.0.1
CHATGPT_AGENT_PORT=4317
